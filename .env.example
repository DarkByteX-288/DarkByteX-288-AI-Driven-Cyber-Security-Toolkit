# Copy this file to .env and set values for your deployment.
# Production requires FLASK_ENV=production and a random SECRET_KEY of 32+ chars.
FLASK_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///database.db
NMAP_PATH=

# Comma-separated authorized CIDRs. Defaults are private ranges only.
BASTIONIX_APPROVED_NETWORKS=
BASTIONIX_SCANNER_ALLOW_LOOPBACK=false
BASTIONIX_SCANNER_MAX_HOSTS=64
BASTIONIX_SCANNER_MAX_ACTIVE=2
BASTIONIX_SCANNER_WORKERS=2

# Use shared storage (e.g. Redis) when running multiple application workers.
RATELIMIT_STORAGE_URI=memory://
